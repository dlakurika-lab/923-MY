    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,  -- Добавлено для совместимости
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

